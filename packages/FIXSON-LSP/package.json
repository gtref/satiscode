{
  "name": "fixson-lsp",
  "version": "1.0.0",
  "description": "Language Server for the json language",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --target=node20 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "watch": "tsc -w"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
