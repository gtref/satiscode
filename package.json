{
  "name": "satiscode",
  "version": "2.2.6",
  "description": "A lightweight C/C++, Python, and JSON editor powered by Monaco, clangd, Pyright, and FIXSON.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm --prefix packages/FIXSON-LSP install && npm --prefix packages/FIXSON-LSP run build",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test": "npm run build && node --test",
    "lint": "eslint ."
  },
  "keywords": [
    "electron",
    "monaco",
    "clangd",
    "pyright",
    "fixson",
    "json",
    "c",
    "cpp",
    "python",
    "editor"
  ],
  "author": "gtref",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "marked": "^18.1.1",
    "monaco-editor": "0.57.0",
    "monaco-languageclient": "^11.0.3",
    "vscode-ws-jsonrpc": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^17.12.0"
  },
  "overrides": {
    "dompurify": "$dompurify"
  },
  "build": {
    "appId": "com.satiscode.editor",
    "productName": "Satiscode",
    "icon": "assets/satiacode.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "UI/codebase_indexer/**/*",
      "package.json",
      "icons.js",
      "icons/style1/icons.json",
      "UI/git_sidebar/*",
      "UI/markdown_view/**/*",
      "UI/tab_manager/*",
      "node_modules/**/*",
      "styles/**/*",
      "themes/**/*",
      "themes.js",
      "main/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "lib",
        "to": "lib"
      },
      {
        "from": "PythonLSP",
        "to": "PythonLSP"
      },
      {
        "from": "packages/FIXSON-LSP/dist",
        "to": "FIXSON-LSP/dist"
      },
      {
        "from": "help",
        "to": "help"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
