{
  "name": "satiscode",
  "version": "2.1.0-BETA",
  "description": "A lightweight C/C++ and Python editor powered by Monaco, clangd, and Pyright.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "test": "node --test",
    "lint": "eslint ."
  },
  "keywords": [
    "electron",
    "monaco",
    "clangd",
    "pyright",
    "c",
    "cpp",
    "python",
    "editor"
  ],
  "author": "gtref",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "monaco-editor": "0.57.0",
    "monaco-languageclient": "^11.0.2",
    "vscode-ws-jsonrpc": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  },
  "build": {
    "appId": "com.satiscode.editor",
    "productName": "Satiscode",
    "icon": "assets/satiacode.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "UI/codebase_indexer/**/*",
      "package.json",
      "icons.js",
      "icons/style1/icons.json",
      "UI/git_sidebar/*",
      "UI/tab_manager/*",
      "node_modules/**/*",
      "styles/**/*",
      "themes/**/*",
      "themes.js",
      "main/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "lib",
        "to": "lib"
      },
      {
        "from": "PythonLSP",
        "to": "PythonLSP"
      },
      {
        "from": "help",
        "to": "help"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
